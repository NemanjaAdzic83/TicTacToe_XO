<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher icon background layer (108dp adaptive canvas): dark radial gradient + faint 3x3 grid -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="49.7"
                android:gradientRadius="70">
                <item android:offset="0" android:color="#FF151B3D" />
                <item android:offset="0.6" android:color="#FF0B0F22" />
                <item android:offset="1" android:color="#FF080B18" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Grid lines: cyan at ~12% alpha, so they stay subtle behind the symbols -->
    <path
        android:pathData="M41.3,16.9V91.1M66.7,16.9V91.1M16.9,41.3H91.1M16.9,66.7H91.1"
        android:strokeWidth="0.65"
        android:strokeColor="#1F00E5FF"
        android:strokeLineCap="round" />
</vector>
