<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher icon foreground layer: neon X and O inside the 66dp safe zone.
     VectorDrawable has no blur, so the glow is faked with wider, semi-transparent strokes under each symbol. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- X glow (outer to inner) -->
    <path
        android:pathData="M32,45L50,63M50,45L32,63"
        android:strokeWidth="13"
        android:strokeColor="#1200E5FF"
        android:strokeLineCap="round" />
    <path
        android:pathData="M32,45L50,63M50,45L32,63"
        android:strokeWidth="10"
        android:strokeColor="#2400E5FF"
        android:strokeLineCap="round" />
    <path
        android:pathData="M32,45L50,63M50,45L32,63"
        android:strokeWidth="7.4"
        android:strokeColor="#4D00E5FF"
        android:strokeLineCap="round" />
    <!-- X core -->
    <path
        android:pathData="M32,45L50,63M50,45L32,63"
        android:strokeWidth="5.6"
        android:strokeColor="#FF00E5FF"
        android:strokeLineCap="round" />

    <!-- O glow (outer to inner) -->
    <path
        android:pathData="M57.5,54a9.5,9.5 0,1 1,19 0a9.5,9.5 0,1 1,-19 0"
        android:strokeWidth="12.8"
        android:strokeColor="#12FF35C8" />
    <path
        android:pathData="M57.5,54a9.5,9.5 0,1 1,19 0a9.5,9.5 0,1 1,-19 0"
        android:strokeWidth="9.8"
        android:strokeColor="#24FF35C8" />
    <path
        android:pathData="M57.5,54a9.5,9.5 0,1 1,19 0a9.5,9.5 0,1 1,-19 0"
        android:strokeWidth="7.2"
        android:strokeColor="#4DFF35C8" />
    <!-- O core -->
    <path
        android:pathData="M57.5,54a9.5,9.5 0,1 1,19 0a9.5,9.5 0,1 1,-19 0"
        android:strokeWidth="5.4"
        android:strokeColor="#FFFF35C8" />
