<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_deep_space"
    tools:context=".ui.menu.MainMenuActivity">

    <ImageView
        android:id="@+id/imgLogoX"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginTop="64dp"
        android:contentDescription="@string/content_desc_app_logo"
        app:layout_constraintEnd_toStartOf="@+id/imgLogoO"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_logo_x" />

    <ImageView
        android:id="@+id/imgLogoO"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:contentDescription="@string/content_desc_app_logo"
        app:layout_constraintBottom_toBottomOf="@+id/imgLogoX"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/imgLogoX"
        app:layout_constraintTop_toTopOf="@+id/imgLogoX"
        app:srcCompat="@drawable/ic_logo_o" />

    <TextView
        android:id="@+id/tvAppNAme"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:fontFamily="sans-serif-black"
        android:text="@string/app_name"
        android:textColor="@color/text_primary"
        android:textSize="28sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imgLogoX" />

    <TextView
        android:id="@+id/tvTagline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/app_tagline"
        android:textColor="@color/text_secondary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvAppNAme" />

    <LinearLayout
        android:id="@+id/menuButtonsContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_padding"
        android:layout_marginTop="48dp"
        android:layout_marginEnd="@dimen/screen_padding"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTagline">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSoloMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Widget.Neon.Button.Filled"
            android:text="@string/btn_solo_mode"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDuoMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Widget.Neon.Button.Magenta"
            android:text="@string/btn_duo_mode"
            android:layout_marginTop="14dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Widget.Neon.Button"
            android:text="@string/btn_stats"
            android:layout_marginTop="14dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Widget.Neon.Button"
            android:text="@string/btn_settings"
            android:layout_marginTop="14dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:text="@string/btn_exit"
            android:layout_marginTop="14dp"/>

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>