<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_deep_space"
    tools:context=".ui.game.GameActivity">

    <ImageButton
        android:id="@+id/btnBackMenu"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="16dp"
        android:background="@color/transparent"
        android:contentDescription="@string/content_desc_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/baseline_arrow_back_24" />

    <TextView
        android:id="@+id/tvTurnIndicator"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:text="@string/turn_player_x"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="@+id/btnBackMenu"
        app:layout_constraintEnd_toStartOf="@+id/btnUndo"
        app:layout_constraintStart_toEndOf="@+id/btnBackMenu"
        app:layout_constraintTop_toTopOf="@+id/btnBackMenu" />

    <ImageButton
        android:id="@+id/btnUndo"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:alpha="0.4"
        android:background="@color/transparent"
        android:contentDescription="@string/content_desc_undo"
        android:enabled="false"
        app:layout_constraintBottom_toBottomOf="@+id/btnBackMenu"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/btnBackMenu"
        app:srcCompat="@drawable/ic_undo" />

    <LinearLayout
        android:id="@+id/scoreboardContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card"
        android:orientation="horizontal"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnBackMenu">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textView4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="@string/score_x"
                android:textColor="@color/neon_cyan"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvScoreX"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif-black"
                android:text="0"
                android:textColor="@color/text_primary"
                android:textSize="22sp" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/bg_grid_line"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textView5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="@string/score_draws"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvScoreDraws"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif-black"
                android:text="0"
                android:textColor="@color/text_primary"
                android:textSize="22sp" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/bg_grid_line"/>


        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textView6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="@string/score_o"
                android:textColor="@color/neon_magenta"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvScoreO"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif-black"
                android:text="0"
                android:textColor="@color/text_primary"
                android:textSize="22sp" />
        </LinearLayout>

    </LinearLayout>

    <FrameLayout
        android:id="@+id/boardContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/screen_padding"
        android:layout_marginTop="28dp"
        android:layout_marginEnd="@dimen/screen_padding"
        app:layout_constraintBottom_toTopOf="@+id/btnResetMatch"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/scoreboardContainer"
        app:layout_constraintVertical_bias="0">

        <GridLayout
            android:id="@+id/gridBoad"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_board_container"
            android:columnCount="3"
            android:padding="@dimen/board_padding"
            android:rowCount="3">

            <com.example.tictactoe_xo.ui.widgets.SymbolView
                android:id="@+id/cell0"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:layout_margin="@dimen/board_cell_margin"
                android:background="@drawable/bg_board_cell_selector"
                android:contentDescription="@string/content_desc_cell"/>

            <com.example.tictactoe_xo.ui.widgets.SymbolView
                android:id="@+id/cell1"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:layout_margin="@dimen/board_cell_margin"
                android:background="@drawable/bg_board_cell_selector"
                android:contentDescription="@string/content_desc_cell"/>

            <com.example.tictactoe_xo.ui.widgets.SymbolView
                android:id="@+id/cell2"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:layout_margin="@dimen/board_cell_margin"
                android:background="@drawable/bg_board_cell_selector"
                android:contentDescription="@string/content_desc_cell"/>

            <com.example.tictactoe_xo.ui.widgets.SymbolView
                android:id="@+id/cell3"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:layout_margin="@dimen/board_cell_margin"
                android:background="@drawable/bg_board_cell_selector"
                android:contentDescription="@string/content_desc_cell"/>

            <com.example.tictactoe_xo.ui.widgets.SymbolView
                android:id="@+id/cell4"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:layout_margin="@dimen/board_cell_margin"
                android:background="@drawable/bg_board_cell_selector"
                android:contentDescription="@string/content_desc_cell"/>

            <com.example.tictactoe_xo.ui.widgets.SymbolView
                android:id="@+id/cell5"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:layout_margin="@dimen/board_cell_margin"
                android:background="@drawable/bg_board_cell_selector"
                android:contentDescription="@string/content_desc_cell"/>

            <com.example.tictactoe_xo.ui.widgets.SymbolView
                android:id="@+id/cell6"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:layout_margin="@dimen/board_cell_margin"
                android:background="@drawable/bg_board_cell_selector"
                android:contentDescription="@string/content_desc_cell"/>

            <com.example.tictactoe_xo.ui.widgets.SymbolView
                android:id="@+id/cell7"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:layout_margin="@dimen/board_cell_margin"
                android:background="@drawable/bg_board_cell_selector"
                android:contentDescription="@string/content_desc_cell"/>

            <com.example.tictactoe_xo.ui.widgets.SymbolView
                android:id="@+id/cell8"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:layout_margin="@dimen/board_cell_margin"
                android:background="@drawable/bg_board_cell_selector"
                android:contentDescription="@string/content_desc_cell"/>

        </GridLayout>

        <com.example.tictactoe_xo.ui.widgets.WinLineView
            android:id="@+id/winLineView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>

    </FrameLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnResetMatch"
        style="@style/Widget.Neon.Button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_padding"
        android:layout_marginEnd="@dimen/screen_padding"
        android:layout_marginBottom="16dp"
        android:text="@string/btn_reset_match"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>